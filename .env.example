# SciRAG — Environment Configuration

# Core Application
APP_NAME="SciRAG"
APP_ENV="development"
API_PREFIX="/api/v1"
PORT=8000

# MongoDB Atlas Configuration (Vector Search + Document Store)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/scirag?retryWrites=true&w=majority"
MONGODB_DATABASE="scirag"

# JWT Authentication
JWT_SECRET="scirag_dev_jwt_secret_change_in_production_key_32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Grok / xAI API Generation Provider
XAI_API_KEY="xai-your-api-key-here"
XAI_BASE_URL="https://api.x.ai/v1"
XAI_MODEL="grok-2-latest"

# Cloudinary PDF & Document Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_UPLOAD_FOLDER="scirag/papers"

# Embedding & Reranking Models
EMBEDDING_MODEL="BAAI/bge-large-en-v1.5"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Scientific Parser (GROBID abstraction)
GROBID_URL="http://localhost:8070"

# CORS & Frontend Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# RAG & Pipeline Parameters
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_HYBRID=10
TOP_K_RERANK=5
MAX_AGENT_ITERATIONS=3
MAX_CONTEXT_TOKENS=4000

# Frontend Variables
VITE_APP_NAME="SciRAG"
VITE_API_BASE_URL="/api/v1"
